{
  "name": "sitering-ai",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "description": "24/7 AI receptionist for UK trade contractors. Twilio + LiveKit + Cartesia + OpenAI.",
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "node scripts/apply-migrations.mjs && next build",
    "start": "next start",
    "lint": "node scripts/assert-speech-stack.mjs && eslint .",
    "type-check": "tsc --noEmit",
    "check-env": "node scripts/check-env.mjs",
    "migrate": "node scripts/apply-migrations.mjs",
    "test": "node --import tsx --test tests/pricing.test.ts tests/phone.test.ts",
    "agent:dev": "node --import tsx agent/worker.ts dev",
    "agent:start": "node --import tsx agent/worker.ts start"
  },
  "dependencies": {
    "@livekit/agents": "1.9.0",
    "@livekit/agents-plugin-cartesia": "1.9.0",
    "@livekit/agents-plugin-openai": "1.9.0",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "^2.114.0",
    "dotenv": "18.0.3",
    "livekit-server-sdk": "2.19.1",
    "next": "15.5.26",
    "next-themes": "0.4.6",
    "openai": "6.49.0",
    "pg": "8.23.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "tsx": "^4.20.5",
    "twilio": "6.1.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.15.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "15.5.26",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
