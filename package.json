{
  "name": "sitering-ai",
  "private": true,
  "workspaces": [
    "apps/*",
    "services/telephony-worker"
  ],
  "scripts": {
    "dev:dashboard": "npm run dev -w @sitering/dashboard",
    "dev:telephony": "npm run dev -w @sitering/telephony-worker",
    "db:push": "supabase db push",
    "test": "npm run test -w @sitering/telephony-worker && cd services/agent && python -m pytest tests/ -q",
    "test:telephony": "npm run test -w @sitering/telephony-worker",
    "test:agent": "cd services/agent && python -m pytest tests/ -q",
    "preflight": "node scripts/preflight.mjs",
    "preview:emails": "node scripts/preview-emails.mjs",
    "send:test-email": "node scripts/send-test-email.mjs"
  }
}
