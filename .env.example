# ─── SiteRing AI · Environment Variables ─────────────────────────────
# Copy this file to `.env.local` and fill in real values.
# NEVER commit `.env.local` to git.

# App
NEXT_PUBLIC_APP_NAME="SiteRing AI"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-public-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-secret-key"

# Stripe (https://dashboard.stripe.com/apikeys)
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
# Price IDs (Products → Pricing → copy API IDs)
STRIPE_PRICE_ID_SUBSCRIPTION="price_..."        # £150/mo recurring base plan
STRIPE_PRICE_ID_OVERAGE="price_..."             # £0.10/min metered overage price

# Live demo-call line. Either name works. app_settings.demo_phone_number overrides both.
NEXT_PUBLIC_DEMO_PHONE_NUMBER="+44 20 3966 1248"
NEXT_PUBLIC_DEMO_CALL_NUMBER="+44 20 3966 1248"

# Postgres connection string so `npm run build` applies supabase/migrations.
# If unset, the build warns and continues. If set and SQL fails, the build stops.
DATABASE_URL="postgresql://postgres.[ref]:[password]@aws-0-eu-west-2.pooler.supabase.com:6543/postgres"

# Voice agent (runs separately from the Next.js app: `npm run agent`)
LIVEKIT_URL="wss://your-project.livekit.cloud"
LIVEKIT_API_KEY=""
LIVEKIT_API_SECRET=""
LIVEKIT_AGENT_NAME="sitering-receptionist"
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_SMS_FROM=""
CARTESIA_API_KEY=""
CARTESIA_VOICE_ID=""
OPENAI_API_KEY=""

# LiveKit / Twilio voice agent → webhook auth
# Set an arbitrary shared secret and configure the voice agent to send it as
# `x-webhook-secret` header (or ?secret=) on every call-end POST.
VOICE_WEBHOOK_SECRET="change-me-to-a-long-random-string"

# Optional: where to provision / display numbers from
DEFAULT_NUMBER_COUNTRY_PREFIX="+44"
