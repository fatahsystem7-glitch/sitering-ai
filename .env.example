# ---- Supabase (source of truth) --------------------------------------------
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# browser-side (Vercel only)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ---- LLM --------------------------------------------------------------------
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# ---- LiveKit ----------------------------------------------------------------
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_AGENT_NAME=sitering-receptionist
LIVEKIT_SIP_URI=

# ---- Fish Audio TTS ---------------------------------------------------------
FISH_API_KEY=
FISH_TTS_MODEL=s2.1-pro
FISH_DEFAULT_VOICE_ID=933563129e564b19a115bedd57b7406a
# normal | balanced | low  — 'low' is what makes it feel like a real receptionist
FISH_LATENCY_MODE=low

# ---- Twilio -----------------------------------------------------------------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# ---- STT --------------------------------------------------------------------
DEEPGRAM_API_KEY=

# ---- Service wiring ---------------------------------------------------------
PUBLIC_BASE_URL=https://telephony.sitering.ai
TELEPHONY_WORKER_URL=https://telephony.sitering.ai
TWILIO_VOICE_WEBHOOK_URL=
INTERNAL_API_TOKEN=
LOG_LEVEL=INFO

# ---- Transactional email (Resend) ------------------------------------------
# Unset = mailer no-ops and logs instead of sending (safe for local dev).
RESEND_API_KEY=
MAIL_FROM=sitering <hello@sitering.ai>
MAIL_REPLY_TO=support@sitering.ai
APP_BASE_URL=https://app.sitering.ai

# ---- Call summarisation -----------------------------------------------------
OPENAI_SUMMARY_MODEL=gpt-4.1-mini

# ---- Bundle re-verification ------------------------------------------------
# How many days before `valid_until` we start the bundle-copy renewal.
REVALIDATION_WINDOW_DAYS=30
# Set to false on extra replicas so only one instance runs the daily sweep.
REVALIDATION_SWEEP_ENABLED=true
