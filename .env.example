# SiteRing AI — copy to .env.local and fill in. Never commit real values.
# The health check and `npm run check-env` require every key in this block.

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Direct Postgres connection used by `npm run build` / `npm run migrate`.
# Supabase Dashboard → Project Settings → Database → URI (session pooler is fine).
# Also accepted: SUPABASE_DB_URL, POSTGRES_URL, POSTGRES_PRISMA_URL.
DATABASE_URL=

# LiveKit (voice orchestration + SIP)
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# Optional override. Defaults to <project>.sip.livekit.cloud derived from LIVEKIT_URL.
LIVEKIT_SIP_HOST=
LIVEKIT_SIP_USERNAME=
LIVEKIT_SIP_PASSWORD=
# tls is the usual LiveKit Cloud transport. Use tcp only if your trunk requires it.
LIVEKIT_SIP_TRANSPORT=tls
LIVEKIT_AGENT_NAME=sitering-receptionist

# Twilio (UK +44 inbound + booking SMS)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Preferred for SMS. Otherwise the assigned +44 number or TWILIO_SMS_FROM is used.
TWILIO_MESSAGING_SERVICE_SID=
TWILIO_SMS_FROM=
# Public origin Twilio and auth redirects call back to. No trailing slash.
APP_URL=http://localhost:3000

# Cartesia Ink (STT) + Sonic-3 (TTS). Paste a British voice id from play.cartesia.ai.
CARTESIA_API_KEY=
CARTESIA_VOICE_ID=

# OpenAI — receptionist brain and website import
OPENAI_API_KEY=

# Homepage "Live Demo Call" number. Overridden by app_settings.demo_phone_number when set.
NEXT_PUBLIC_DEMO_PHONE_NUMBER=

# Comma-separated emails that can open /admin before a profile role is flipped.
ADMIN_EMAILS=

# Optional shared secret if the agent posts to /api/booking-sms instead of calling Twilio itself.
AGENT_INTERNAL_SECRET=
